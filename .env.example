# ============================================
# 环境变量配置示例
# ============================================
# 使用方法：
# 1. 复制此文件并重命名为 .env
# 2. 填入你的实际 API Key
# 3. 不要将 .env 文件提交到版本控制
# ============================================

# Notion API Token (必须)
# 获取地址: https://www.notion.so/my-integrations
NOTION_API_TOKEN=ntn_your_token_here

# Anthropic API Key (必须)
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# 可选：指定 Claude 模型
# 默认使用 claude-sonnet-4-20250514
# CLAUDE_MODEL=claude-sonnet-4-20250514

# 126 邮箱授权码（用于 auto_weekly_report.py 发送周报邮件）
# 获取方式：登录 126 邮箱 → 设置 → POP3/SMTP/IMAP → 新增授权密码
MAIL_SENDER=your_126_auth_code_here

# Gamma API Key (可选; 用于自动把周报 Markdown 转成在线 PPT)
# 需要 Gamma Pro+ 订阅, 在 https://gamma.app/settings/api 获取
GAMMA_API_KEY=your_gamma_api_key_here
